APP_NAME=feed-import
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8084
# host ports of the app and MySQL
# APP_PORT=8084
# FORWARD_DB_PORT=3311

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feed_import
DB_USERNAME=feed
DB_PASSWORD=feed

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

FEED_API_TOKEN=change-me

KAFKA_BROKERS=kafka:9092
